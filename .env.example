# Application
APP_NAME=cohort-insights-api
APP_ENV=development
LOG_LEVEL=INFO

# MongoDB
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=cohort_insights

# Redis
REDIS_URL=redis://redis:6379/0
CONTENT_CACHE_TTL_SECONDS=86400
RATE_LIMIT_MAX_ACTIVE_DOCS=3
RATE_LIMIT_KEY_TTL_SECONDS=3600

# Two-Stage Pipeline Simulation
STAGE1_MIN_DELAY_SECONDS=10.0
STAGE1_MAX_DELAY_SECONDS=20.0
STAGE2_MIN_DELAY_SECONDS=5.0
STAGE2_MAX_DELAY_SECONDS=15.0
STAGE_FAILURE_PROBABILITY=0.10
WORKER_CONCURRENCY=4
STAGE_MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=1.0